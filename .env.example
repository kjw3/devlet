# ─── App ports ────────────────────────────────────────────────────────────────
# Shared bearer token required by the web UI and all tRPC calls.
# Generate with: openssl rand -hex 32
DEVLET_AUTH_TOKEN=replace-with-a-long-random-token
# Host port for the API server (default: 3001)
SERVER_PORT=3001
# Host port for the web UI (default: 3000)
WEB_PORT=3000
# Public base URL users access Devlet through.
# Use http://localhost:3000 for local dev, or your HTTPS/Tailscale URL in shared environments.
DEVLET_PUBLIC_BASE_URL=http://localhost:3000
# Optional: one or more SSH public keys for direct agent SSH access.
# Separate multiple keys with literal \n characters if you keep them on one line.
# DEVLET_AGENT_SSH_AUTHORIZED_KEYS=ssh-ed25519 AAAAC3Nza... you@host
# Published app image to run for the server container
SERVER_IMAGE=ghcr.io/your-org/devlet-server:sha-<commit>
# Published app image to run for the web container
WEB_IMAGE=ghcr.io/your-org/devlet-web:sha-<commit>

# ─── Portainer ────────────────────────────────────────────────────────────────
# URL of your existing Portainer instance — no trailing slash
PORTAINER_URL=http://portainer.example.com:9000
# API key — create one in Portainer → Account Settings → Access Tokens
PORTAINER_API_KEY=ptr_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: comma-separated endpoint IDs or names to exclude from scheduling
# PORTAINER_EXCLUDED_ENDPOINTS=1,gpu-lab,staging-swarm

# ─── Proxmox ──────────────────────────────────────────────────────────────────
# URL of your Proxmox VE API — no trailing slash
PROXMOX_URL=https://proxmox.example.com:8006
# User in user@realm format
PROXMOX_USER=root@pam
# API token name (the part after the !)
# Create via: Datacenter → Permissions → API Tokens → Add
PROXMOX_TOKEN_ID=devlet
# API token secret UUID
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Set to "true" to skip TLS verification (for self-signed certs)
PROXMOX_INSECURE=false
# Optional: comma-separated Proxmox node names to exclude from scheduling
# PROXMOX_EXCLUDED_NODES=pve-test,pve-gpu-02
# Default node to schedule agents on (must exist in your cluster)
PROXMOX_NODE=pve
# Storage pool for VM/LXC disks
PROXMOX_STORAGE=local-lvm
# Free storage kept aside for other workloads; disk maximum also excludes pending hires.
DEVLET_DISK_RESERVE_GB=10
# Hard per-agent disk request ceiling, even when the selected pool has more free space.
DEVLET_AGENT_DISK_MAX_GB=100
# LXC OS template path (e.g. local:vztmpl/debian-12-standard_12.2-1_amd64.tar.zst)
PROXMOX_LXC_TEMPLATE=
# QEMU template VM ID to clone for VM agents (0 = not configured)
PROXMOX_QEMU_TEMPLATE_ID=0
# Optional dedicated QEMU template for GPU agents — clone of the main template
# with the NVIDIA driver installed inside (see docs/gpu-agents.md). Falls back
# to PROXMOX_QEMU_TEMPLATE_ID when unset.
# PROXMOX_QEMU_GPU_TEMPLATE_ID=0
# Optional root@pam API token — PVE allows ONLY root to set hostpci* (GPU
# passthrough), even for tokens with full privileges. Create with:
#   pveum user token add root@pam devlet-gpu --privsep 0
# Used solely for the GPU config step; everything else runs least-privileged.
# PROXMOX_ROOT_USER=root@pam
# PROXMOX_ROOT_TOKEN_ID=devlet-gpu
# PROXMOX_ROOT_TOKEN_SECRET=
# Storage for QEMU (VM) disks. Shared storage (e.g. Ceph RBD) lets one template
# serve every node; when this equals the template's own disk storage, clones
# become linked (instant, copy-on-write).
# PROXMOX_QEMU_STORAGE=ceph-vms
# Optional: PCI id to pass through as hostpci0 when the QEMU template lacks GPU config.
# When unset and a GPU agent is requested, the first usable GPU on the target
# node is auto-detected (PCI addresses differ per node).
# PROXMOX_GPU_PCI_ID=0000:01:00.0
# Bridge guests attach to (default vmbr0)
# PROXMOX_BRIDGE=vmbr0
# Optional VLAN tag for guest NICs (QEMU clones inherit the template's VLAN;
# set this to override or to tag LXC guests, e.g. 2100)
# PROXMOX_VLAN=2100

# ─── Komodo ─────────────────────────────────────────────────────────────────
# URL of your Komodo core — no trailing slash
KOMODO_URL=https://komodo.example.com
# API key + secret pair (Komodo → Settings → API keys)
KOMODO_API_KEY=xxxx
KOMODO_API_SECRET=xxxx
# Optional: comma-separated server names/IDs to exclude from scheduling
# KOMODO_EXCLUDED_SERVERS=docker-test,gpu-lab
# Optional override: how Devlet reaches a Komodo server (web terminal / SSH). Devlet detects each
# server's LAN address on its own (even when Komodo's agent runs in a container), so you only
# need this for servers where that is wrong or unreachable from the Devlet server.
# Map server name (or id) to a hostname/IP. Takes priority over everything else.
# KOMODO_SERVER_HOSTS=gpu1=192.168.10.50,docker1=docker1.lan

# ─── Tailscale ──────────────────────────────────────────────────────────────
# Running agents join your tailnet as ephemeral nodes (devlet-<agent-id>) and leave when stopped.
# Full setup (policy file, OAuth clients, troubleshooting): docs/tailscale.md
# OAuth client for AGENTS (Tailscale admin → Settings → Trust credentials), limited to ONE tag:
#   scopes Auth Keys: Write + Devices (Core): Write, tag tag:devlet-agent only
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
# Optional: tailnet name (default "-", the OAuth client's own tailnet)
# TAILSCALE_TAILNET=-
# Optional: tag applied to agent nodes — must be defined in tagOwners (default tag:devlet-agent)
# TAILSCALE_AGENT_TAG=tag:devlet-agent
# Optional: the Devlet server joins the tailnet too so it can proxy agents over it when their
# host address is unreachable. Needs this tag in tagOwners and a grant to the agent tag, e.g.
#   "tagOwners": { "tag:devlet-server": ["you@example.com"] }
#   "grants": [{ "src": ["tag:devlet-server"], "dst": ["tag:devlet-agent"], "ip": ["*"] }]
# Tailscale only mints a key if the request names ALL tags of the OAuth client, so this needs a
# SECOND OAuth client with only tag:devlet-server (scope: Auth Keys: Write). Keep the agent
# client above limited to tag:devlet-agent.
# TAILSCALE_SERVER_OAUTH_CLIENT_ID=
# TAILSCALE_SERVER_OAUTH_CLIENT_SECRET=
# TAILSCALE_SERVER_TAG=tag:devlet-server
# TAILSCALE_SERVER_ENABLED=true
# Optional: set to false so agents only join the tailnet when hired with the toggle on
# TAILSCALE_DEFAULT_ENABLED=true

# ─── Providers ────────────────────────────────────────────────────────────────
# API keys forwarded automatically to every agent container the server spawns.
# Agents that don't need a given key ignore it.
# Per-agent env vars set at hire time take precedence over these platform defaults.
# You only need ONE provider. With just LITELLM_BASE_URL + LITELLM_API_KEY set, every
# coding agent (claude-code, codex, opencode, pi, gemini) routes through LiteLLM.
# Use the proxy root for LITELLM_BASE_URL (no /v1); set a default model on the Providers page.
ANTHROPIC_API_KEY=sk-ant-xxxx
OPENAI_API_KEY=sk-xxxx
GEMINI_API_KEY=AIzaxxxx
OPENROUTER_API_KEY=sk-or-xxxx
LITELLM_BASE_URL=https://litellm.example.com
LITELLM_API_KEY=sk-xxxx
# Optional: model alias every LiteLLM-backed agent uses. If unset, each agent picks a fitting
# model from what your proxy serves (/v1/models). Per-agent and Providers-page models win.
# LITELLM_MODEL=claude-sonnet-4-5
# Optional: context window to tell Claude Code for LiteLLM models. Normally leave unset — Devlet
# reads each model's real limits from the gateway (needs the key to allow info_routes, e.g.
# allowed_routes: ["llm_api_routes", "info_routes"]). Set this only if that lookup is denied.
# LITELLM_CONTEXT_TOKENS=200000
# DEVLET_OPENCLAW_AUTO_PAIR=true   # dev/home-lab only: auto-approves pending OpenClaw device pair requests
# NVIDIA_API_KEY=nvapi-xxxx   # build.nvidia.com — OpenAI-compatible at integrate.api.nvidia.com/v1
# GROQ_API_KEY=gsk_xxxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# FIRECRAWL_API_KEY=fc-xxxx    # used by Hermes for web scraping
# TAVILY_API_KEY=tvly-xxxx     # used by Hermes for web search

# ─── Agent container images ───────────────────────────────────────────────────
# Override the Docker image used for each agent type.
# For public registries, prefer pinned ghcr.io tags or digests.
# AGENT_IMAGE_CLAUDE_CODE=ghcr.io/your-org/devlet-agent-base:sha-<commit>
# AGENT_IMAGE_CODEX=ghcr.io/your-org/devlet-agent-base:sha-<commit>
# AGENT_IMAGE_OPENCODE=ghcr.io/your-org/devlet-agent-base:sha-<commit>
# AGENT_IMAGE_PI=ghcr.io/your-org/devlet-agent-base:sha-<commit>
# AGENT_IMAGE_GEMINI=ghcr.io/your-org/devlet-agent-base:sha-<commit>
# Image for GPU-required coding agents (NVIDIA env + CUDA runtime on top of the base).
# See docs/gpu-agents.md. GPU-capable hosts need the NVIDIA driver + nvidia-container-toolkit.
# AGENT_IMAGE_GPU=ghcr.io/your-org/devlet-agent-gpu:sha-<commit>
# AGENT_IMAGE_OPENCLAW=ghcr.io/your-org/devlet-agent-openclaw:sha-<commit>
# AGENT_IMAGE_NANOCLAW=ghcr.io/your-org/devlet-agent-nanoclaw:sha-<commit>
# AGENT_IMAGE_HERMES=ghcr.io/your-org/devlet-agent-hermes:sha-<commit>
# AGENT_IMAGE_MOLTIS=ghcr.io/your-org/devlet-agent-moltis:sha-<commit>
# AGENT_IMAGE_NEMOCLAW=node:22.23.3-slim
