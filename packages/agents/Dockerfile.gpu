# ── devlet/agent-gpu ──────────────────────────────────────────────────────────
# GPU-capable layer above the base coding-agent image.
#
# Built for agents hired with gpu.required (see docs/gpu-agents.md). Keeps the
# default image slim: CUDA userland costs ~1–2 GB and non-GPU hosts never pull
# this tag.
#
# The NVIDIA driver itself is never baked in — nvidia-container-toolkit injects
# the host driver userland (libcuda.so.1, nvidia-smi) at container start. What
# this layer adds:
#   - explicit NVIDIA env (not dependent on toolkit defaults)
#   - CUDA runtime userland for binaries that don't bundle their own
#   - nvcc + headers + gcc so the agent can compile raw CUDA kernels
#   - PyTorch cu124 (validated on sm_61/Pascal — see docs/gpu-agents.md)
#   - devlet-gpu-check: GPU status + data-plane probe in the agent log
#   - GPU facts as env (DEVLET_GPU_*, set by the entrypoint)
#
# Resulting image is ~7 GB: only GPU hosts pull this tag.
#
# Build args:
#   BASE_AGENT_IMAGE — the base image to layer on (CI pins it to the sha tag)
#   CUDA_VERSION     — CUDA runtime package suffix (debian12 repo), x86_64 only
# ──────────────────────────────────────────────────────────────────────────────

ARG BASE_AGENT_IMAGE=ghcr.io/kjw3/devlet-agent-base:latest
FROM ${BASE_AGENT_IMAGE}

ARG CUDA_VERSION=12-4
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG VERSION=0.1.0
ARG REPOSITORY_URL=https://github.com/kjw3/devlet

ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    TORCH_CUDA_ARCH_LIST="6.1" \
    PATH="/usr/local/cuda/bin:${PATH}"

USER root

# CUDA runtime userland (x86_64 only — NVIDIA's debian12 repo covers arm64
# poorly for desktop parts, and arm64 agent hosts get the driver userland via
# toolkit injection anyway). Deliberately the minimal `cuda-cudart` (libcudart
# only, ~40 MB): framework wheels (torch, jax) bundle their own CUDA libs, so
# the full cuda-runtime meta-package (cuBLAS/cuFFT/…, ~4 GB) is dead weight
# here. Bump CUDA_VERSION's package to `cuda-runtime-${CUDA_VERSION}` if an
# agent needs the full userland preinstalled.
RUN set -eux; \
    if [ "$(uname -m)" = "x86_64" ]; then \
      curl -fsSL --retry 10 --retry-delay 2 --retry-all-errors \
        "https://developer.download.nvidia.com/compute/cuda/repos/debian12/x86_64/cuda-keyring_1.1-1_all.deb" \
        -o /tmp/cuda-keyring.deb; \
      dpkg -i /tmp/cuda-keyring.deb; \
      rm -f /tmp/cuda-keyring.deb; \
      apt-get update; \
      apt-get install -y --no-install-recommends "cuda-cudart-${CUDA_VERSION}"; \
      rm -rf /var/lib/apt/lists/*; \
    fi

# Compute stack (x86_64 — the CUDA repo layer above is x86_64-only and torch
# cu124 wheels ship no linux/aarch64 build): gcc/g++ (host compiler for nvcc,
# pip source builds), pip, CUDA toolkit compiler (nvcc/ptxas + headers) for
# raw kernels, and PyTorch cu124 with numpy. Deliberately NOT the full
# cuda-runtime meta-package (cuBLAS/cuFFT/…, ~4 GB) — torch wheels bundle
# their own CUDA libraries. numpy pinned <2: torch 2.4.1 predates the numpy
# 2.0 ABI. TORCH_CUDA_ARCH_LIST=6.1 keeps any source-built extensions Pascal-
# only (the fleet's desktop parts are GT 1030-class).
RUN set -eux; \
    if [ "$(uname -m)" = "x86_64" ]; then \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        build-essential python3-pip \
        "cuda-nvcc-${CUDA_VERSION}" "cuda-cudart-dev-${CUDA_VERSION}"; \
      rm -rf /var/lib/apt/lists/*; \
      ln -sfn "/usr/local/cuda-$(echo "${CUDA_VERSION}" | tr - .)" /usr/local/cuda; \
      python3 -m pip install --no-cache-dir "torch==2.4.1" \
        --index-url https://download.pytorch.org/whl/cu124 \
        --extra-index-url https://pypi.org/simple; \
      python3 -m pip install --no-cache-dir "numpy<2"; \
    fi

COPY packages/agents/devlet-gpu-check.sh /usr/local/bin/devlet-gpu-check
COPY packages/agents/devlet-cuda-probe.py /usr/local/bin/devlet-cuda-probe
RUN chmod +x /usr/local/bin/devlet-gpu-check /usr/local/bin/devlet-cuda-probe

USER agent

LABEL org.opencontainers.image.title="devlet-agent-gpu"
LABEL org.opencontainers.image.description="GPU layer above devlet-agent-base: NVIDIA env + CUDA toolkit + PyTorch + GPU probes"
LABEL org.opencontainers.image.source="${REPOSITORY_URL}"
LABEL org.opencontainers.image.revision="${VCS_REF}"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL devlet.agent.type="gpu"
